#!/bin/sh
# dev/tools/hooks/pre-commit
# Standards backstop: lint staged .gd/.tscn before the commit lands.
#
# This is the harness-agnostic net (see dev/standards/standards_enforcement.md).
# The in-loop hook (lint_changed.py) only fires inside Claude Code; this one
# fires at `git commit` no matter which agent or human wrote the code.
#
# Install once (from repo root):
#     git config core.hooksPath dev/tools/hooks
#
# It lints ONLY the files staged in this commit, so adoption stays incremental
# and a pre-existing backlog never blocks an unrelated commit.

gd_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(gd|tscn)$')
yaml_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.yaml$')

status=0

if [ -n "$gd_files" ]; then
  # shellcheck disable=SC2086
  python dev/tools/lint_standards.py --files $gd_files
  status=$?
fi

if [ -n "$yaml_files" ]; then
  # shellcheck disable=SC2086
  python dev/tools/lint_yaml_keys.py --files $yaml_files
  yaml_status=$?
  [ "$yaml_status" -ne 0 ] && status=$yaml_status
fi

if [ "$status" -ne 0 ]; then
  echo ""
  echo "Commit blocked by lint. Fix the violations above, or run"
  echo "  python dev/tools/lint_standards.py --files \$gd_files"
  echo "  python dev/tools/lint_yaml_keys.py --files \$yaml_files"
  echo "to re-check. (To bypass in an emergency: git commit --no-verify.)"
fi

exit $status
